# Copy to .env and fill in. Never commit a real .env file.
# The bot token and owner chat id are secrets: keep them on the host only.

# Telegram bot token from @BotFather (make a NEW bot for Mr T, do not
# reuse another project's bot).
MR_T_BOT_TOKEN=

# Your Telegram chat id (message @userinfobot for it). Only this chat
# may talk to Mr T.
MR_T_OWNER_CHAT_ID=

# Local model name for Ollama (default: qwen2.5:7b).
AGENT_MODEL=
